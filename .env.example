# Copy to .env and adjust. All variables are validated at startup (src/shared/config.ts).

# --- Runtime ---
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Set to true only when running behind a trusted reverse proxy (affects client IP for rate limiting).
TRUST_PROXY=false

# --- PostgreSQL (docker-compose reads the POSTGRES_* values) ---
POSTGRES_USER=ggi
POSTGRES_PASSWORD=ggi_dev_password
POSTGRES_DB=ggi
POSTGRES_PORT=5432
DATABASE_URL=postgres://ggi:ggi_dev_password@127.0.0.1:5432/ggi

# --- HTTP hardening ---
# Comma-separated exact origins. Empty = no cross-origin access. Wildcards are rejected.
CORS_ALLOWED_ORIGINS=http://localhost:5173
REQUEST_BODY_LIMIT_BYTES=16384
REQUEST_TIMEOUT_MS=10000
# Required by the health probe (X-Health-Token header). Min 32 chars: `openssl rand -hex 32`.
HEALTH_CHECK_TOKEN=replace-with-output-of-openssl-rand-hex-32

# --- OIDC provider (any compliant provider: Keycloak, Auth0, Cognito, Entra ID, ...) ---
OIDC_ISSUER=https://idp.example.com/realms/ggi
OIDC_AUDIENCE=ggi-api
OIDC_JWKS_URI=https://idp.example.com/realms/ggi/protocol/openid-connect/certs
# Asymmetric algorithms only (RS*, PS*, ES*, EdDSA).
OIDC_ALGORITHMS=RS256
# Dot-path to the roles array in the access token, e.g. realm_access.roles (Keycloak)
# or https://ggi.example.com/roles (Auth0 namespaced claim).
OIDC_ROLES_CLAIM=realm_access.roles
DPOP_PROOF_MAX_AGE_SECONDS=60

# --- Rate limiting (requests per window) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_IP_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_CHAT_MAX=30
RATE_LIMIT_SUBSCRIPTION_MAX=60

# --- Simulations ---
AI_MOCK_LATENCY_MS=800
PAYMENT_FAILURE_RATE=0.1
